# Copy to .env (never commit .env). Every value has a working local default,
# so .env is only needed to override something.

# --- Airflow ---------------------------------------------------------------
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Shared by api-server/scheduler/dag-processor; use a long random string.
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-long-random-string
# Optional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# --- Lake (MinIO locally) --------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
LAKE_BUCKET=job-platform-lake
# MINIO_IMAGE=chainguard/minio:latest

# --- Ingestion ---------------------------------------------------------------
# Cron (UTC). "none" disables scheduling (manual triggers only).
JOB_INGESTION_SCHEDULE=0 6 * * *
JOB_INGESTION_PAUSED_ON_CREATION=false
# Identify yourself to the providers; include a contact address.
JOB_INGESTION_USER_AGENT=job-platform-ingestion/0.1 (personal job aggregator; contact: you@example.com)
# JOB_INGESTION_HTTP_CONNECT_TIMEOUT=10
# JOB_INGESTION_HTTP_READ_TIMEOUT=90
# JOB_INGESTION_HTTP_MAX_ATTEMPTS=3

# Himalayas incremental sweep
# HIMALAYAS_MAX_PAGES=200
# HIMALAYAS_INITIAL_LOOKBACK_HOURS=48
# HIMALAYAS_OVERLAP_SECONDS=3600
# HIMALAYAS_REQUEST_INTERVAL_SECONDS=1.0

# We Work Remotely category feeds (comma-separated slugs)
# WWR_FEEDS=remote-design-jobs,remote-full-stack-programming-jobs
# WWR_REQUEST_INTERVAL_SECONDS=2.0

# Endpoint overrides (defaults are the public provider URLs)
# HIMALAYAS_API_URL=https://himalayas.app/jobs/api
# REMOTEOK_API_URL=https://remoteok.com/api
# REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
# WWR_FEED_BASE_URL=https://weworkremotely.com/categories
